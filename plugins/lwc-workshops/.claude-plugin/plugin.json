{
  "name": "lwc",
  "version": "0.6.1",
  "description": "Learning-with-Court workshops. Ships the setup-workshop, workshop-orchestrator, and lesson-runner skills \u2014 install a workshop, start it, and walk every lesson. MCP transport is the LWC Custom Connector (Cowork) or the @learning-with-court/cli (Claude Code).",
  "author": {
    "name": "Court Schuett"
  },
  "keywords": [
    "lwc",
    "learning-with-court",
    "workshops",
    "platform",
    "education"
  ],
  "permissions": {
    "allow": [
      "Bash(node --version)",
      "Bash(git --version)",
      "Bash(command -v lwc)",
      "Bash(lwc:*)",
      "Bash(uname:*)",
      "Bash(gh --version)",
      "Bash(gh auth status)",
      "Bash(pnpm --version)",
      "Bash(git config --global user.name)",
      "Bash(aws configure list-profiles)",
      "Bash(test -s ~/.zshrc || test -s ~/.bashrc)",
      "Bash(ls:*)",
      "Bash(test -d:*)",
      "Bash(test -e:*)",
      "Bash(test -s:*)",
      "Bash(realpath:*)",
      "Bash(mkdir -p:*)",
      "Bash(pwd)",
      "Bash(date -u +%Y-%m-%dT%H:%M:%SZ)"
    ]
  }
}
