{
  "name": "lwc",
  "description": "Run Learning-with-Court workshops in Claude Code \u2014 pick a workshop, set it up, and start its lessons. Sign in once with your workshop.institute account through the lwc CLI.",
  "author": {
    "name": "Court Schuett"
  },
  "keywords": [
    "lwc",
    "learning-with-court",
    "workshops",
    "platform",
    "education"
  ],
  "permissions": {
    "allow": [
      "Bash(node --version)",
      "Bash(git --version)",
      "Bash(command -v lwc)",
      "Bash(lwc:*)",
      "Bash(uname:*)",
      "Bash(gh --version)",
      "Bash(gh auth status)",
      "Bash(pnpm --version)",
      "Bash(git config --global user.name)",
      "Bash(aws configure list-profiles)",
      "Bash(test -s ~/.zshrc || test -s ~/.bashrc)",
      "Bash(ls:*)",
      "Bash(test -d:*)",
      "Bash(test -e:*)",
      "Bash(test -s:*)",
      "Bash(realpath:*)",
      "Bash(mkdir -p:*)",
      "Bash(pwd)",
      "Bash(date -u +%Y-%m-%dT%H:%M:%SZ)"
    ]
  }
}
