{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lwc assist turn --hook-event UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lwc assist turn --hook-event Stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
